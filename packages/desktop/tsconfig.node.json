{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["electron-src/**/*.ts", "shared/**/*.ts"],
  "exclude": ["electron-src/resources/backend"]
}
